{
  "name": "cortico-world-screen-diary",
  "version": "0.2.0",
  "type": "module",
  "description": "活动日记：消费窥屏助手的事件流，把工作状态投影到二维空间并平滑；细节会淡忘，只留大概。需要 cortico-world-screen-sense。",
  "author": "Wwhois163wW",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wwhois163wW/cortico-world-screen-diary.git"
  },
  "homepage": "https://github.com/Wwhois163wW/cortico-world-screen-diary#readme",
  "bugs": {
    "url": "https://github.com/Wwhois163wW/cortico-world-screen-diary/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": ["cortico-world", "cortico", "diary", "activity", "screen"],
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "活动日记",
    "tags": ["memory", "requires-extension", "sensitive-data", "experimental"],
    "icon": "assets/icon.svg",
    "locales": {
      "en": {
        "displayName": "Activity Diary",
        "description": "Consumes the screen-sense event stream and turns foreground switches and vision captions into a searchable timeline. Requires cortico-world-screen-sense to be installed and enabled."
      }
    },
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": ["src", "assets", "dist", "describe.json", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
